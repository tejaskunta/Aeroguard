# --- datasets & weights: never commit these to git -------------------------
# Datasets are huge and often licensed.
# Weights are build artifacts and should be versioned via releases/artifacts.
datasets/
runs/
weights/
*.pt
*.onnx
*.engine
*.trt
!yolov8n.pt.placeholder

# curated model release tree (explicitly shipped to Aeroguard)
!models/
!models/**/*.pt
!models/**/*.onnx

# Ultralytics drops pretrained checkpoints in the working dir on first run
yolov8*.pt
yolo11*.pt

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# virtualenvs
.venv/
venv/
env/
ENV/
backend/venv/

# --- tooling ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- experiment tracking ---------------------------------------------------
wandb/
mlruns/
lightning_logs/
events.out.tfevents.*

# --- editors & OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
*.key
*.pem

# --- jetson build logs -----------------------------------------------------
jetson/build_engine.log

# --- LaTeX build artifacts (paper/) ----------------------------------------
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.out
paper/main.fls
paper/main.fdb_latexmk
paper/*.synctex.gz

# --- research artifacts: reproducible / transient ------------------------
# stage-2 crop images (regenerate with phase5_build_crops.py)
# `**` covers both the shared seed-0 set (paper_results/stage2/crops/) and the
# per-seed sets that detector seeds 3 and 4 generate from their own stage-1
# checkpoints (paper_results/stage2/s2_ratio1_s3/crops/, ...). Manifests and
# stats.json stay tracked so every crop set is auditable without its JPEGs.
paper_results/stage2/**/crops/**/*.jpg
paper_results/ablation/*/crops/**/*.jpg
paper_results/ablation/*/crops/manifest.csv
# contamination-free subset images (regenerate with make_leaky_vs_clean.py)
paper_results/leaky_v1/clean_subset/images/
paper_results/leaky_v1/clean_subset/labels/
# transient run logs (commands + outcomes live in RUN_LOG.md)
logs/*.log
logs/*.out
logs/*.err
logs/_tmp_*
logs/*.pid
*.pid
